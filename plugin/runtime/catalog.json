{
 "params": [
  {
   "name": "pitch",
   "min": 50,
   "max": 1100,
   "default": 210,
   "label": "Pitch",
   "unit": "Hz",
   "help": "Fundamental frequency of the vocal folds."
  },
  {
   "name": "loudness",
   "min": 0,
   "max": 1,
   "default": 0.72,
   "label": "Effort",
   "unit": "",
   "help": "Lung pressure. More effort is louder and slightly brighter."
  },
  {
   "name": "tenseness",
   "min": 0,
   "max": 1,
   "default": 0.4,
   "label": "Tension",
   "unit": "",
   "help": "Glottal pulse shape (LF Rd). Low is lax and soft, high is pressed and bright."
  },
  {
   "name": "breath",
   "min": 0,
   "max": 1,
   "default": 0.15,
   "label": "Breath",
   "unit": "",
   "help": "Glottal leak and aspiration noise."
  },
  {
   "name": "voicing",
   "min": 0,
   "max": 1,
   "default": 1,
   "label": "Voicing",
   "unit": "",
   "help": "Vocal-fold adduction. 0 opens the glottis for whisper or voiceless sounds."
  },
  {
   "name": "vibratoDepth",
   "min": 0,
   "max": 1,
   "default": 0.18,
   "label": "Vibrato",
   "unit": "",
   "help": "Vibrato depth (up to ±85 cents)."
  },
  {
   "name": "vibratoRate",
   "min": 3,
   "max": 9,
   "default": 5.4,
   "label": "Vibrato rate",
   "unit": "Hz",
   "help": "Vibrato speed."
  },
  {
   "name": "tongueX",
   "min": 0,
   "max": 1,
   "default": 0.36,
   "label": "Tongue front",
   "unit": "",
   "help": "Tongue body position, back (0) to front (1)."
  },
  {
   "name": "tongueY",
   "min": 0,
   "max": 1,
   "default": 0.3,
   "label": "Tongue height",
   "unit": "",
   "help": "Tongue body height, low (0) to high (1)."
  },
  {
   "name": "tipPlace",
   "min": 0,
   "max": 1,
   "default": 0.35,
   "label": "Tip place",
   "unit": "",
   "help": "Tongue tip target, teeth (0) to behind the ridge (1)."
  },
  {
   "name": "tipClose",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Tip closure",
   "unit": "",
   "help": "Tongue tip constriction. 1 seals the tract."
  },
  {
   "name": "dorsumClose",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Back closure",
   "unit": "",
   "help": "Tongue back against the soft palate (k, g, ng)."
  },
  {
   "name": "jaw",
   "min": 0,
   "max": 1,
   "default": 0.62,
   "label": "Jaw",
   "unit": "",
   "help": "Jaw opening."
  },
  {
   "name": "lipOpen",
   "min": 0,
   "max": 1,
   "default": 0.62,
   "label": "Lips open",
   "unit": "",
   "help": "Lip aperture. 0 closes the lips."
  },
  {
   "name": "lipRound",
   "min": 0,
   "max": 1,
   "default": 0.12,
   "label": "Lip round",
   "unit": "",
   "help": "Rounding and protrusion; lengthens the tract."
  },
  {
   "name": "velum",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Nasal",
   "unit": "",
   "help": "Velum opening; couples the nasal cavity."
  },
  {
   "name": "tractLength",
   "min": 11,
   "max": 32,
   "default": 14.2,
   "label": "Tract length",
   "unit": "cm",
   "help": "Overall vocal tract length (size), excluding lip protrusion."
  },
  {
   "name": "throat",
   "min": 0,
   "max": 1,
   "default": 0.5,
   "label": "Throat",
   "unit": "",
   "help": "Pharynx width (tongue root). Wider is darker and warmer."
  },
  {
   "name": "gain",
   "min": 0,
   "max": 1,
   "default": 0.7,
   "label": "Output",
   "unit": "",
   "help": "Output level."
  },
  {
   "name": "humanize",
   "min": 0,
   "max": 1,
   "default": 0.45,
   "label": "Humanize",
   "unit": "",
   "help": "Jitter, shimmer and slow pitch drift."
  },
  {
   "name": "space",
   "min": 0,
   "max": 1,
   "default": 0.18,
   "label": "Room",
   "unit": "",
   "help": "Small room reverberation."
  },
  {
   "name": "lateral",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Lateral",
   "unit": "",
   "help": "Side channel around the tongue tip for l."
  },
  {
   "name": "rhotic",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Rhotic",
   "unit": "",
   "help": "Bunched-r narrowing of pharynx and palate; lowers F3."
  },
  {
   "name": "register",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Falsetto",
   "unit": "",
   "help": "Vocal register, chest (0) to falsetto (1): thin, never fully closed folds. Flip it fast for a yodel."
  },
  {
   "name": "fry",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Fry",
   "unit": "",
   "help": "Vocal fry: paired, irregular, creaky pulses."
  },
  {
   "name": "growl",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Growl",
   "unit": "",
   "help": "Ventricular folds flapping at half the pitch: a rough growl."
  },
  {
   "name": "twang",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Twang",
   "unit": "",
   "help": "Narrowed epilarynx: a bright, ringing, nasal-sounding twang."
  },
  {
   "name": "pharynx",
   "min": 0.75,
   "max": 1.3,
   "default": 1,
   "label": "Pharynx",
   "unit": "×",
   "help": "Throat length relative to the mouth: longer in adult men (≈1.15), shorter in children (≈0.85)."
  },
  {
   "name": "trill",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Trill",
   "unit": "",
   "help": "The narrowest constriction (tongue tip, lips or uvula) flaps in the airflow about 27 times a second."
  },
  {
   "name": "glottal",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Glottal closure",
   "unit": "",
   "help": "The vocal folds pressed shut: a glottal stop, and the seal behind an ejective."
  },
  {
   "name": "larynx",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Larynx raise",
   "unit": "",
   "help": "The larynx rises like a piston and squeezes the pharynx (ejectives)."
  },
  {
   "name": "suction",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Tongue suction",
   "unit": "",
   "help": "The tongue body pulls down between two oral seals (clicks)."
  },
  {
   "name": "mic",
   "min": 0,
   "max": 1,
   "default": 0.4,
   "label": "Mic distance",
   "unit": "",
   "help": "Close: proximity bass and a bit louder. Far: thinner, duller, quieter and roomier. 0.4 is neutral."
  },
  {
   "name": "eqLow",
   "min": -12,
   "max": 12,
   "default": 0,
   "label": "Low",
   "unit": "dB",
   "help": "EQ low shelf at 220 Hz."
  },
  {
   "name": "eqMid",
   "min": -12,
   "max": 12,
   "default": 0,
   "label": "Mid",
   "unit": "dB",
   "help": "EQ peak at 1.6 kHz."
  },
  {
   "name": "eqHigh",
   "min": -12,
   "max": 12,
   "default": 0,
   "label": "High",
   "unit": "dB",
   "help": "EQ high shelf at 5.5 kHz."
  },
  {
   "name": "comp",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Compressor",
   "unit": "",
   "help": "Evens out the level (threshold falls and ratio rises with the amount)."
  },
  {
   "name": "drive",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Drive",
   "unit": "",
   "help": "Tape-style saturation (tanh)."
  },
  {
   "name": "creature",
   "min": 0,
   "max": 2,
   "default": 0,
   "label": "Creature",
   "unit": "",
   "help": "Sound source: 0 the human airway, 1 a songbird syrinx, 2 an elephant trumpet."
  },
  {
   "name": "harmony",
   "min": 0,
   "max": 1,
   "default": 0,
   "label": "Second voice",
   "unit": "",
   "help": "Songbird: the syrinx's second side sings (1 + this) × the pitch."
  }
