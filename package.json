{
  "name": "hermes-voice-lab",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Articulatory voice synthesizer plugin for Hermes Desktop",
  "license": "MIT",
  "scripts": {
    "build:engine": "node scripts/build-engine.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:engine": "cargo test --release --manifest-path engine/Cargo.toml",
    "typecheck": "tsc --noEmit -p .",
    "dev": "node scripts/build.mjs --assets-only && vite",
    "package": "node scripts/package.mjs",
    "calibrate": "cargo run --release --manifest-path engine/Cargo.toml --bin calibrate > src/core/vowels.generated.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
